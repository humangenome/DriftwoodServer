<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../DriftwoodServer/DriftwoodServer.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The host mod's config reader has no Unity or BepInEx dependency, on purpose: it is the one
         file where a cross-lane key-name disagreement turns into a server running on defaults, so
         it is worth testing on its own. Linked rather than duplicated. -->
    <Compile Include="../../host-mod/DriftwoodHost/HostConfig.cs" Link="Linked/HostConfig.cs" />
    <!-- The API signature, for the same reason and a sharper one. Three codebases have to
         compute it identically - this server, the Driftwood launcher and the hosting endpoint -
         and a mismatch has NO SYMPTOM: every signature is well-formed and none of them verify,
         which presents as "the console cannot connect" with nothing in any log. It has no Unity
         or BepInEx dependency either, so it can be pinned here to a golden vector whose other
         half lives in the hosting endpoint's own test. -->
    <Compile Include="../../host-mod/DriftwoodHost/ApiSignature.cs" Link="Linked/ApiSignature.cs" />
    <!-- The owner layer's dependency-free pieces, linked for the same reason. The parser eats
         attacker-controlled persona names, the block list is the store a ban's survival depends
         on, and the audit log is the record support answers from - each is provable without a
         running game, so it is proven here. -->
    <Compile Include="../../host-mod/DriftwoodHost/SteamProfileParser.cs" Link="Linked/SteamProfileParser.cs" />
    <Compile Include="../../host-mod/DriftwoodHost/Blocklist.cs" Link="Linked/Blocklist.cs" />
    <Compile Include="../../host-mod/DriftwoodHost/OwnerAudit.cs" Link="Linked/OwnerAudit.cs" />
    <!-- The Discord alert pipe's pure parts: the webhook-URL gate (a customer-editable file must
         never point this server's outbound POST at an arbitrary machine), the payload shape
         (allowed_mentions pinned empty because half of every line is a player-chosen name), and
         the join/leave diff. No Unity or BepInEx dependency; the HTTP worker is never started
         here. Json.cs rides along because the payload builder uses it. -->
    <Compile Include="../../host-mod/DriftwoodHost/Json.cs" Link="Linked/Json.cs" />
    <Compile Include="../../host-mod/DriftwoodHost/DiscordAlerts.cs" Link="Linked/DiscordAlerts.cs" />
    <!-- The pure half of identity claims: the SteamID64 range gate, the strict string
         parsers and the address binding. Every field it judges arrives on a PUBLIC,
         unauthenticated route, which is exactly why the judging is kept dependency-free
         and proven here. The connection-table half stays in IdentityClaims.cs and is
         proven on the canary instead. -->
    <Compile Include="../../host-mod/DriftwoodHost/IdentityClaimRules.cs" Link="Linked/IdentityClaimRules.cs" />
  </ItemGroup>
  <PropertyGroup>
    <NoWarn>$(NoWarn);CS8618;CS8600;CS8601;CS8602;CS8603;CS8604;CS8625</NoWarn>
  </PropertyGroup>
</Project>
