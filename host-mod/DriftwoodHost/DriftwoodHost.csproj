<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>DriftwoodHost</AssemblyName>
    <RootNamespace>DriftwoodHost</RootNamespace>
    <DebugType>none</DebugType>
    <!-- MUST stay true. With it off the compiler emits no AssemblyFileVersion attribute, so
         the DLL's Win32 version resource is 0.0.0.0 no matter what -p:FileVersion says. The
         host side reads that resource on every start
         (it reads (Get-Item DriftwoodHost.dll).VersionInfo.FileVersion)
         and requires it to equal the pinned tag. A 0.0.0.0 stamp can never match, so every
         start would log "DriftwoodHost.dll disagrees, forcing re-copy" and re-robocopy the
         whole loader tree forever, on every server, in silence. Caught by the FileVersion
         assert in scripts/package-server-overlay.sh, which exists for exactly this. -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- MSB3277: the game ships several assemblies at conflicting versions; the retail
         build resolves them at runtime and we must not rewrite its bindings.
         CS0436: the game's own types collide with framework facades in the ref set. -->
    <NoWarn>$(NoWarn);MSB3277;CS0436</NoWarn>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(ManagedDir)</AssemblySearchPaths>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Point this at a real "How to Fish_Data\Managed" to compile against a live install.
         The checked-in default is a local copy that is gitignored. -->
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(MSBuildThisFileDirectory)refs</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(MSBuildThisFileDirectory)BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(MSBuildThisFileDirectory)0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="FishNet.Runtime"><HintPath>$(ManagedDir)\FishNet.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="FishyUnityTransport"><HintPath>$(ManagedDir)\FishyUnityTransport.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Networking.Transport"><HintPath>$(ManagedDir)\Unity.Networking.Transport.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="com.rlabrecque.steamworks.net"><HintPath>$(ManagedDir)\com.rlabrecque.steamworks.net.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
